DATABASE_URL=
NEXT_PUBLIC_ENABLE_AGENTATION=false

# Canonical site origin used for metadata (Open Graph URLs, metadataBase).
# Defaults to https://meefeed.vercel.app when unset.
NEXT_PUBLIC_SITE_URL=

# Cloudinary — report screenshot storage.
# The extension uploads screenshots directly to Cloudinary using a server-signed
# request, so only the API secret must stay private. Get these from the
# Cloudinary dashboard (Settings -> API Keys).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional. Defaults to "feedme/reports".
CLOUDINARY_UPLOAD_FOLDER=

# Transactional account email. The sender must be verified in Resend.
RESEND_API_KEY=
AUTH_EMAIL_FROM="FeedMe <accounts@your-domain.com>"

# Bearer secret for the notification retry/maintenance endpoint.
# Call GET /api/internal/notification-worker from a trusted scheduler.
INTERNAL_OPERATIONS_SECRET=
