DATABASE_URL=
NEXT_PUBLIC_ENABLE_AGENTATION=false

# Authentication mode. Defaults to "demo" when unset.
# - demo: valid email format only; signup creates a session immediately.
# - verified: requires transactional email configuration and email verification.
AUTH_MODE=demo

# Shared public account offered on the demo login screen. These values are sent
# to the browser in demo mode and must never be treated as private credentials.
DEMO_ACCOUNT_EMAIL=demo.admin@feedme.app
DEMO_ACCOUNT_PASSWORD=FeedMeDemo123

# Canonical site origin used for metadata (Open Graph URLs, metadataBase).
# Defaults to https://meefeed.vercel.app when unset.
NEXT_PUBLIC_SITE_URL=

# Cloudinary — report screenshot storage.
# The extension uploads screenshots directly to Cloudinary using a server-signed
# request, so only the API secret must stay private. Get these from the
# Cloudinary dashboard (Settings -> API Keys).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional. Defaults to "feedme/reports".
CLOUDINARY_UPLOAD_FOLDER=

# Transactional account email. Required only when AUTH_MODE=verified. The sender
# must be verified in Resend.
RESEND_API_KEY=
AUTH_EMAIL_FROM="FeedMe <accounts@your-domain.com>"

# Bearer secret for the notification and auth-email retry/maintenance endpoint.
# Call GET /api/internal/notification-worker from a trusted scheduler at least
# every five minutes so transient delivery failures are retried.
INTERNAL_OPERATIONS_SECRET=
